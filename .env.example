# Uygulamanın dışarıdan erişilen adresi (QR bağlantısı bu adresle üretilir)
APP_URL=http://localhost:3002

# İlk açılışta yönetici hesabı yoksa bu bilgilerle oluşturulur
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=degistir-beni-123

# Veritabanı (SQLite) ve yüklenen dosyaların klasörü
DATA_DIR=./data

# Onaydan sonra bu kadar gün işlem yapılmayan firmalar "Takip gerekiyor" olarak işaretlenir
FOLLOWUP_DAYS=7
